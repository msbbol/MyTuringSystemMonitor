<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyTuringSystemMonitor.Service</RootNamespace>
    <AssemblyName>MyTuringSystemMonitor.Service</AssemblyName>
    <!-- Runs as a Windows service (LocalSystem) in production; still runnable as a console app for dev. -->
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!--
      The Web SDK turns on server GC, which sizes the heap for a busy web server: one heap per core,
      each with its own allocation budget, and memory it never gives back. This process draws one
      320x480 frame every few seconds, so workstation GC keeps it small (hundreds of MB -> tens).
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyTuringSystemMonitor\MyTuringSystemMonitor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The service serves the UI from next to its exe (a service's working directory is System32). -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
