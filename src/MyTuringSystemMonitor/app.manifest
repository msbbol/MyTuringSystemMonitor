<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!-- Run at the caller's level so the app also works without admin (PerfCounter/Fake
             sensors, headless Null display). LibreHardwareMonitor's full sensor set needs
             admin: to get it, launch this exe elevated ("Run as administrator"), or change
             the level below to "requireAdministrator" to always prompt for elevation. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
