<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MyTuringSystemMonitor.Tools.VendorThemeImporter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the vendor app's BinaryFormatter (NRBF) theme payloads without needing its assembly. -->
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.12" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

</Project>
